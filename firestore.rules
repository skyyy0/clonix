rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserVaultProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             data.defaultRegionCode is string && data.defaultRegionCode.size() >= 2 && data.defaultRegionCode.size() <= 10 &&
             data.strictAntiDetect is bool;
    }

    function isValidCloudClone(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.packageName is string && data.packageName.size() >= 1 && data.packageName.size() <= 200 &&
             data.originalAppName is string && data.originalAppName.size() >= 1 && data.originalAppName.size() <= 120 &&
             data.cloneLabel is string && data.cloneLabel.size() >= 1 && data.cloneLabel.size() <= 160 &&
             data.instanceNumber is int && data.instanceNumber >= 1 && data.instanceNumber <= 999 &&
             data.devicePlatform is string && data.devicePlatform in ['ANDROID', 'IOS'] &&
             data.regionCode is string && data.regionCode.size() >= 2 && data.regionCode.size() <= 10 &&
             data.regionName is string && data.regionName.size() >= 1 && data.regionName.size() <= 80 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.timezoneId is string && data.timezoneId.size() >= 1 && data.timezoneId.size() <= 80 &&
             data.localeTag is string && data.localeTag.size() >= 2 && data.localeTag.size() <= 20 &&
             data.carrierName is string && data.carrierName.size() >= 1 && data.carrierName.size() <= 80 &&
             data.mccMnc is string && data.mccMnc.size() >= 3 && data.mccMnc.size() <= 20 &&
             data.virtualModel is string && data.virtualModel.size() >= 1 && data.virtualModel.size() <= 100 &&
             data.virtualManufacturer is string && data.virtualManufacturer.size() >= 1 && data.virtualManufacturer.size() <= 80 &&
             data.virtualAndroidId is string && data.virtualAndroidId.size() >= 4 && data.virtualAndroidId.size() <= 64 &&
             data.virtualFingerprintHash is string && data.virtualFingerprintHash.size() >= 4 && data.virtualFingerprintHash.size() <= 64 &&
             data.launchMode is string && data.launchMode in ['ISOLATED_CONTAINER', 'NATIVE_BRIDGE'] &&
             data.targetWebUrl is string && data.targetWebUrl.size() <= 500 &&
             data.proxyEnabled is bool &&
             data.proxySummary is string && data.proxySummary.size() <= 200;
    }

    function isValidCloudAuditLog(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.cloneId is string && data.cloneId.size() >= 1 && data.cloneId.size() <= 128 &&
             data.eventType is string && data.eventType.size() >= 1 && data.eventType.size() <= 40 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.detail is string && data.detail.size() <= 400;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'defaultRegionCode', 'strictAntiDetect', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'defaultRegionCode', 'strictAntiDetect', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserVaultProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserVaultProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'defaultRegionCode', 'strictAntiDetect', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /clones/{cloneId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(cloneId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(cloneId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'packageName', 'originalAppName', 'cloneLabel', 'instanceNumber',
                           'devicePlatform', 'regionCode', 'regionName', 'city', 'timezoneId',
                           'localeTag', 'carrierName', 'mccMnc', 'virtualModel', 'virtualManufacturer',
                           'virtualAndroidId', 'virtualFingerprintHash', 'launchMode', 'targetWebUrl',
                           'proxyEnabled', 'proxySummary', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'packageName', 'originalAppName', 'cloneLabel', 'instanceNumber',
                           'devicePlatform', 'regionCode', 'regionName', 'city', 'timezoneId',
                           'localeTag', 'carrierName', 'mccMnc', 'virtualModel', 'virtualManufacturer',
                           'virtualAndroidId', 'virtualFingerprintHash', 'launchMode', 'targetWebUrl',
                           'proxyEnabled', 'proxySummary', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidCloudClone(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(cloneId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().packageName == existing().packageName &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidCloudClone(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'cloneLabel', 'devicePlatform', 'regionCode', 'regionName', 'city',
                           'timezoneId', 'localeTag', 'carrierName', 'mccMnc', 'virtualModel',
                           'virtualManufacturer', 'virtualAndroidId', 'virtualFingerprintHash',
                           'launchMode', 'targetWebUrl', 'proxyEnabled', 'proxySummary', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(cloneId) && request.auth.uid == userId;
      }

      match /auditLogs/{logId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(logId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(logId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'cloneId', 'eventType', 'title', 'detail', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'cloneId', 'eventType', 'title', 'detail', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidCloudAuditLog(incoming());

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(logId) && request.auth.uid == userId;
      }
    }
  }
}
